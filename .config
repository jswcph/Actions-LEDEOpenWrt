# This is an empty file, please overwrite it after generating the .config file with the source code
# 正确指明达发/联发科 Airoha 芯片平台
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-mf=y

# 基础网页组件
CONFIG_PACKAGE_luci=y

# 自定义皮肤（LEDE 源码自带高级版 Argon）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# 自定义核心插件（网络硬件加速，跑满全速必选）
CONFIG_PACKAGE_luci-app-turboacc=y

# 网页端控制台终端
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-openclash=y
